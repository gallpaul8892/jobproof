{
  "name": "jobproof",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "shared",
    "web",
    "mobile",
    "e2e"
  ],
  "scripts": {
    "gen": "npm run gen -w @jobproof/shared",
    "gen:check": "npm run gen:check -w @jobproof/shared",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test -w @jobproof/shared -w @jobproof/web -w @jobproof/mobile",
    "build": "npm run build -w @jobproof/web",
    "e2e": "npm run test -w @jobproof/e2e"
  },
  "devDependencies": {
    "@redocly/cli": "^2.76.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "js-yaml": "^4.3.2",
    "minimatch": "^11.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
