{
  "name": "@jobproof/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages --emptyOutDir && node scripts/pages-postbuild.mjs && node scripts/check-dist.mjs --pages --dir=dist-pages",
    "preview": "vite preview --port 8080 --strictPort",
    "preview:pages": "vite preview --mode pages --outDir dist-pages --base /jobproof/web/ --port 8080 --strictPort",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jobproof/shared": "*",
    "@tanstack/react-query": "^5.108.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
