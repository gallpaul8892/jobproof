# Copy to .env (make up and scripts/dev.sh do this for you). .env is gitignored.
# Values below are dev-only and safe to publish. Never reuse them outside local development.

APP_ENV=local

# docker compose uses the db host; scripts/dev.sh overrides this to 127.0.0.1:5544.
DATABASE_URL=postgresql+psycopg://jobproof:jobproof@db:5432/jobproof

# AWS (INFRA-3): instead of DATABASE_URL, set the parts below (not both). ECS injects secret
# fields but cannot assemble a URL. In staging/production DB_SSLMODE must be verify-full and the
# committed RDS CA bundle (backend/certs/rds-global-bundle.pem) is used unless DB_SSLROOTCERT is set.
# DB_HOST=  DB_PORT=5432  DB_NAME=  DB_USER=  DB_PASSWORD=  DB_SSLMODE=  DB_SSLROOTCERT=
# One-off tasks only: DB_MIGRATOR_PASSWORD / DB_APP_PASSWORD (db-roles), ADMIN_INITIAL_PASSWORD
# (create-user), DEMO_SEED_ALLOWED=true and DEMO_PASSWORD (app.seed.demo, AWS dev only).

# Credentials for the compose db container.
POSTGRES_USER=jobproof
POSTGRES_PASSWORD=jobproof
POSTGRES_DB=jobproof

# Secrets: at least 32 characters.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_TTL_SECONDS=1800
PHOTO_URL_SECRET=dev-only-photo-secret-change-me-0123456789ab
PHOTO_URL_TTL_SECONDS=900

# Operative app device sessions (T-003b): access token lifetime (seconds, at least 60), days
# without use before the refresh token expires, days from sign-in at most, and the seconds in which
# a just-replaced refresh token is still accepted (a lost response).
DEVICE_ACCESS_TTL_SECONDS=900
DEVICE_SESSION_IDLE_DAYS=30
DEVICE_SESSION_MAX_DAYS=90
REFRESH_REUSE_GRACE_SECONDS=60
# Lowest mobile app version the server supports (semver); reported by GET /api/v1/app/status.
MOBILE_MIN_VERSION_ANDROID=0.0.0

# Used to build absolute photo URLs.
PUBLIC_API_BASE_URL=http://localhost:8000
# Comma separated, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Refused (startup fails) unless APP_ENV is local or test: the list includes the admin password.
DEMO_ACCOUNTS_ENABLED=true
LOG_LEVEL=INFO

# Company name given to the settings record by the first migration on an empty database
# (read once; afterwards the Admin changes it in the app). Default: Arbour Services.
# DEFAULT_COMPANY_NAME=Arbour Services

# Tests only (rejected when APP_ENV=production): pin the clock and the seed's "today".
# FIXED_NOW=2026-10-15T10:00:00Z
# SEED_ANCHOR_DATE=2026-10-15

# Web container only: written to /config.js at container start.
API_BASE_URL=http://localhost:8000
